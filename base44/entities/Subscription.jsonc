{
  "name": "Subscription",
  "type": "object",
  "description": "Sage subscription state, whatever the store. Written ONLY by a server-side webhook running as service role (Stripe today, Apple later). Users can read their own row but can never create or modify one, so nobody can grant themselves Sage from the client.",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "The subscriber's email, matched to the signed-in user"
    },
    "source": {
      "type": "string",
      "enum": [
        "stripe",
        "apple"
      ],
      "default": "stripe",
      "description": "Which store the subscription was bought from. Entitlement does not depend on this: it only decides which billing controls to show and which webhook owns the row."
    },
    "external_id": {
      "type": "string",
      "description": "The store's own identifier for this subscription: the Stripe subscription id, or later the Apple original transaction id."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "trialing",
        "past_due",
        "canceled",
        "incomplete",
        "unpaid"
      ],
      "default": "incomplete",
      "description": "Normalised status. Stripe statuses map to these directly; Apple states will be mapped onto the same set."
    },
    "plan": {
      "type": "string",
      "enum": [
        "sage_monthly",
        "sage_yearly"
      ],
      "description": "Which Sage price the customer is on"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "stripe_price_id": {
      "type": "string"
    },
    "current_period_end": {
      "type": "string",
      "description": "ISO timestamp when the paid period ends"
    },
    "cancel_at_period_end": {
      "type": "boolean",
      "default": false
    },
    "last_event_at": {
      "type": "string",
      "description": "ISO timestamp of the last store event applied to this row"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional short description of the subscription"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "stripe_service_only"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "stripe_service_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "stripe_service_only"
      }
    }
  }
}