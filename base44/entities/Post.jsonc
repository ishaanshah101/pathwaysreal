{
  "name": "Post",
  "type": "object",
  "description": "Feed posts. Written ONLY by the create-post backend function, which sets the author from the session and runs the same safety screening as messaging. Members read the feed through the getFeed function, which never hands out another member's email. Only an admin can edit a published post, so nothing can be changed after it passed screening.",
  "properties": {
    "author_email": {
      "type": "string",
      "rls": {
        "read": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.author_email": "{{user.email}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "author_name": {
      "type": "string"
    },
    "author_role": {
      "type": "string",
      "enum": [
        "student",
        "college_student",
        "educator",
        "counselor"
      ],
      "default": "student"
    },
    "author_headline": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "general",
        "applications",
        "essays",
        "scholarships",
        "majors",
        "campus_life",
        "internships",
        "careers",
        "test_prep"
      ],
      "default": "general"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "helpful_count": {
      "type": "number",
      "default": 0,
      "description": "How many members marked this post helpful. Written only by the react-to-post backend function, as a fresh count of PostReaction rows."
    },
    "attachments": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "mime": {
            "type": "string"
          },
          "size": {
            "type": "number"
          },
          "kind": {
            "type": "string"
          },
          "scanned": {
            "type": "boolean"
          },
          "url": {
            "type": "string",
            "description": "Legacy public attachments only"
          }
        }
      }
    }
  },
  "required": [
    "title",
    "body"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "post_service_only"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}