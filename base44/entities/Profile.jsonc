{
  "name": "Profile",
  "type": "object",
  "description": "A member's profile. Written ONLY by the save-profile backend function (or an admin), so a client can never set is_minor, verified, or suspended on itself. Raw rows are readable only by their owner and admins; every other member sees a shaped view from the get-profile function.",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Owner's email, used to link the profile to the logged in user"
    },
    "full_name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "student",
        "college_student",
        "educator",
        "counselor"
      ],
      "default": "student"
    },
    "grade": {
      "type": "string",
      "description": "Grade level or institution"
    },
    "school": {
      "type": "string"
    },
    "goals": {
      "type": "string"
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bio": {
      "type": "string"
    },
    "headline": {
      "type": "string"
    },
    "birth_year": {
      "type": "number",
      "description": "Four-digit year of birth, collected at onboarding. Age is computed from this on the server; sign-up is refused under 13."
    },
    "is_minor": {
      "type": "boolean",
      "default": false,
      "description": "Computed and written only by the save-profile function from birth_year. Never accepted from a client."
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "True only when Pathways has actually checked this person's stated role. Settable by an admin only."
    },
    "suspended": {
      "type": "boolean",
      "default": false,
      "description": "Set by an admin from the moderation queue. A suspended account cannot message, post, or send connection requests."
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "sage_monthly",
        "sage_yearly"
      ],
      "default": "free"
    },
    "onboarded": {
      "type": "boolean",
      "default": false,
      "description": "True once the user has completed onboarding and may enter the main app"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "profile_service_only"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}