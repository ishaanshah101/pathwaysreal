{
  "name": "SageMessage",
  "type": "object",
  "description": "One turn in a Sage conversation. Written by the sage-ask function, which is also the only place an answer is generated, so a stored answer always corresponds to a real, paid-for model call.",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "thread_id": {
      "type": "string",
      "description": "The SageThread this turn belongs to"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ],
      "default": "user"
    },
    "content": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "description": "Files the student attached to this question, e.g. an essay draft or a transcript",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "content"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}