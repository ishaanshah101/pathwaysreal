{
  "name": "Message",
  "type": "object",
  "description": "One-to-one messages. Written ONLY by the send-message backend function, which verifies an accepted Connection, applies rate limits, and runs safety screening before a row exists.",
  "properties": {
    "thread_key": {
      "type": "string",
      "description": "The two participant emails sorted alphabetically and joined with a pipe"
    },
    "from_email": {
      "type": "string"
    },
    "from_name": {
      "type": "string"
    },
    "to_email": {
      "type": "string"
    },
    "body": {
      "type": "string"
    }
  },
  "required": [
    "thread_key",
    "from_email",
    "to_email",
    "body"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "message_service_only"
      }
    },
    "read": {
      "$or": [
        {
          "data.from_email": "{{user.email}}"
        },
        {
          "data.to_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "message_service_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "message_service_only"
      }
    }
  }
}