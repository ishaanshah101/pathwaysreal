  },
  "description": "Every day, warns members whose name is not a real first and last name, and deletes accounts (with all their posts, connections and other data) once their one-week deadline has passed.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "real_name_check",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_names": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "enforceRealNames",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Check member names",
            "description": "Warn, then delete the account after 7 days"
          }
        }
      }
    ]
  },
  "name": "Real Name Check"
}