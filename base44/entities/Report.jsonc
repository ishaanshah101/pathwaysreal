{
  "name": "Report",
  "type": "object",
  "description": "A private safety report. Members submit through memberActions, which verifies the reporter, context and request limits. Only admins can read or manage reports.",
  "properties": {
    "reporter_email": {
      "type": "string"
    },
    "reported_email": {
      "type": "string"
    },
    "context_type": {
      "type": "string",
      "enum": [
        "message",
        "post",
        "profile"
      ],
      "default": "profile"
    },
    "context_id": {
      "type": "string",
      "description": "The reported message, post or profile identifier"
    },
    "reason": {
      "type": "string",
      "enum": [
        "inappropriate_contact",
        "sexual_content",
        "harassment",
        "spam",
        "impersonation",
        "safety_concern",
        "other"
      ],
      "default": "safety_concern"
    },
    "details": {
      "type": "string",
      "maxLength": 2000
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "reviewing",
        "actioned",
        "dismissed"
      ],
      "default": "open"
    },
    "admin_notes": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string"
    }
  },
  "required": [
    "reporter_email",
    "reported_email",
    "reason"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}