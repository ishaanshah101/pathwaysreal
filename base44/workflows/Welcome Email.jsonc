{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "welcome_email",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_welcome": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendWelcomeEmail",
            "args": {
              "email": "${ .trigger.email }",
              "full_name": "${ .trigger.full_name }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send welcome email",
            "description": "Via Gmail"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "app_user_auth",
      "events": [
        "signup"
      ]
    }
  },
  "description": "Sends a welcome email to new signups via the connected Gmail account",
  "name": "Welcome Email"
}